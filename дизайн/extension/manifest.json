{
  "manifest_version": 3,
  "name": "EKT · Макет ИИ-консультанта",
  "version": "0.4.0",
  "description": "Интерактивный дизайн-макет чата поверх ekt.kz. Без сервера и без изменений реальной корзины.",
  "action": { "default_title": "Открыть консультанта на ekt.kz" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://ekt.kz/*", "https://www.ekt.kz/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["app.html"],
    "matches": ["https://ekt.kz/*", "https://www.ekt.kz/*"]
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; img-src 'self'"
  }
}
