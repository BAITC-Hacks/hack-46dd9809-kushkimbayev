HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
DATA_MODE=demo
EKT_API_BASE=https://ekt.kz/api
EKT_API_USER=
EKT_API_PASSWORD=
# Full catalog, 500 products/page, cached on disk; emergency pagination cap.
EKT_SYNC_MAX_PAGES=1000
# Empty means no paid requests. Never put this key in the extension.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Hard request/token ceilings, persisted locally. Also set a project budget in OpenAI.
AI_DAILY_REQUEST_LIMIT=30
AI_DAILY_TOKEN_LIMIT=60000
AI_SESSION_REQUEST_LIMIT=6
# Optional extra development origins. The packaged extension is allowed automatically.
EXTENSION_ORIGINS=
