{
  "manifest_version": 3,
  "name": "EKT · ИИ-консультант",
  "version": "0.6.0",
  "description": "Ассистент по каталогу ekt.kz. Ключи и обработка запросов — на вашем сервере.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8787/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ekt.kz/*",
        "https://www.ekt.kz/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "widget.html",
        "widget.css",
        "widget.js"
      ],
      "matches": [
        "https://ekt.kz/*",
        "https://www.ekt.kz/*"
      ]
    }
  ],
  "action": {
    "default_title": "Открыть консультанта EKT"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "key": ""
}